@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f5f7fa;
  background: #07090d;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(circle at 50% -20%, rgba(82, 111, 255, 0.12), transparent 40%),
    #07090d;
}

button {
  font: inherit;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.app {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.background-glow {
  position: fixed;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  filter: blur(120px);
  pointer-events: none;
  opacity: 0.12;
}

.glow-one {
  top: 200px;
  left: -300px;
  background: #4f6cff;
}

.glow-two {
  top: 600px;
  right: -300px;
  background: #8b5cf6;
}

.topbar {
  height: 76px;
  border-bottom: 1px solid #1b1f29;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42px;
  background: rgba(7, 9, 13, 0.75);
  backdrop-filter: blur(20px);
  position: sticky;
  top: 0;
  z-index: 20;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #ffffff, #8c96a8);
  color: #080a0e;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.brand-name {
  font-size: 14px;
  font-weight: 700;
}

.brand-meta {
  margin-top: 2px;
  color: #686f7d;
  font-size: 11px;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #9299a8;
  font-size: 12px;
}

.status-indicator {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #49d17d;
  box-shadow: 0 0 12px rgba(73, 209, 125, 0.8);
}

.status-indicator.large {
  width: 9px;
  height: 9px;
}

.container {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
}

.hero {
  min-height: 410px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 50px;
  border-bottom: 1px solid #1a1e27;
}

.hero-label,
.section-kicker {
  color: #737b8b;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.8px;
}

.hero-label {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 22px;
}

.hero-label span {
  width: 18px;
  height: 1px;
  background: #596274;
}

.hero h1 {
  margin: 0;
  font-size: clamp(48px, 7vw, 82px);
  line-height: 0.98;
  letter-spacing: -5px;
  font-weight: 700;
}

.hero h1 span {
  color: #737b8b;
}

.hero p {
  max-width: 550px;
  margin: 28px 0 0;
  color: #8b93a3;
  font-size: 15px;
  line-height: 1.7;
}

.hero-status {
  min-width: 230px;
  padding: 25px;
  border: 1px solid #242936;
  border-radius: 14px;
  background: rgba(13, 16, 22, 0.7);
}

.hero-status-label {
  color: #666e7d;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
  margin-bottom: 18px;
}

.hero-status-value {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 15px;
  font-weight: 600;
}

.hero-status-url {
  margin-top: 10px;
  color: #656d7c;
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-bottom: 1px solid #1a1e27;
}

.metric-card {
  padding: 30px 25px;
  border-right: 1px solid #1a1e27;
}

.metric-card:last-child {
  border-right: 0;
}

.metric-label {
  display: block;
  color: #636b79;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.metric-card strong {
  display: block;
  margin-top: 11px;
  font-size: 30px;
  letter-spacing: -1.5px;
}

.metric-description {
  display: block;
  margin-top: 5px;
  color: #555d6c;
  font-size: 11px;
}

.section {
  padding: 70px 0;
  border-bottom: 1px solid #1a1e27;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 30px;
}

.section-heading h2 {
  margin: 8px 0 5px;
  font-size: 24px;
  letter-spacing: -0.8px;
}

.section-heading p {
  margin: 0;
  color: #626a79;
  font-size: 12px;
}

.button {
  border: 0;
  cursor: pointer;
  transition: 0.2s ease;
}

.button.secondary {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border: 1px solid #292e39;
  border-radius: 8px;
  background: #10131a;
  color: #d9dde5;
  font-size: 11px;
}

.button.secondary:hover {
  background: #171b24;
  border-color: #3a4150;
}

.button.secondary span {
  color: #727a89;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.product-card {
  min-height: 270px;
  padding: 22px;
  border: 1px solid #202530;
  border-radius: 14px;
  background: linear-gradient(145deg, #10131a, #0b0e13);
  transition: transform 0.25s ease, border-color 0.25s ease;
}

.product-card:hover {
  transform: translateY(-3px);
  border-color: #353c4a;
}

.product-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-id {
  color: #5f6775;
  font-family: "JetBrains Mono", monospace;
  font-size: 9px;
}

.product-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #596274;
}

.product-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  margin-top: 48px;
  border: 1px solid #2a303c;
  border-radius: 12px;
  color: #aab2c0;
  background: #151922;
  font-size: 12px;
  font-weight: 700;
}

.product-card h3 {
  margin: 18px 0 30px;
  font-size: 19px;
  letter-spacing: -0.5px;
}

.product-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.product-bottom span {
  color: #5e6674;
  font-size: 10px;
}

.product-bottom strong {
  font-size: 16px;
}

.two-column {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.compact {
  padding: 60px 0;
}

.icon-button {
  width: 34px;
  height: 34px;
  border: 1px solid #292f3b;
  border-radius: 8px;
  background: #10131a;
  color: #9ba3b2;
  cursor: pointer;
}

.icon-button:hover {
  background: #181c24;
}

.data-table {
  border: 1px solid #202530;
  border-radius: 10px;
  overflow: hidden;
}

.table-head,
.table-row {
  display: grid;
  grid-template-columns: 60px 1fr 1.5fr;
  align-items: center;
  gap: 15px;
  padding: 15px 17px;
}

.table-head {
  background: #10131a;
  color: #596171;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1px;
}

.table-row {
  border-top: 1px solid #1c2029;
  color: #9ba2b0;
  font-size: 11px;
}

.table-row strong {
  color: #e1e4e9;
}

.muted {
  color: #555e6d;
  font-family: "JetBrains Mono", monospace;
  font-size: 10px;
}

.empty-state {
  min-height: 210px;
  border: 1px dashed #252b36;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 8px;
}

.empty-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  margin-bottom: 5px;
  border: 1px solid #292f3a;
  border-radius: 9px;
  color: #687181;
  font-family: "JetBrains Mono", monospace;
  font-size: 9px;
}

.empty-state strong {
  font-size: 12px;
}

.empty-state > span {
  color: #555e6c;
  font-size: 10px;
  margin-bottom: 12px;
}

.observability {
  margin: 70px 0;
  padding: 35px;
  border: 1px solid #242a35;
  border-radius: 16px;
  background:
    radial-gradient(circle at 90% 0%, rgba(81, 98, 255, 0.08), transparent 35%),
    #0d1016;
}

.observability-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 30px;
}

.observability-header h2 {
  margin: 9px 0 6px;
  font-size: 23px;
  letter-spacing: -0.8px;
}

.observability-header p {
  margin: 0;
  color: #646d7c;
  font-size: 11px;
}

.observability-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  justify-content: flex-end;
}

.observability-stack span {
  padding: 6px 8px;
  border: 1px solid #282e39;
  border-radius: 6px;
  color: #747d8c;
  font-family: "JetBrains Mono", monospace;
  font-size: 8px;
}

.test-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.test-card {
  display: grid;
  grid-template-columns: 42px 1fr 15px;
  align-items: center;
  gap: 13px;
  padding: 15px;
  border: 1px solid #252b36;
  border-radius: 10px;
  background: #11141b;
  color: #fff;
  text-align: left;
  cursor: pointer;
  transition: 0.2s ease;
}

.test-card:hover {
  border-color: #3b4351;
  background: #151922;
}

.test-card.danger:hover {
  border-color: #58383b;
}

.test-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #191d26;
  color: #8f98a8;
  font-family: "JetBrains Mono", monospace;
  font-size: 9px;
  font-weight: 500;
}

.test-card strong {
  display: block;
  font-size: 11px;
}

.test-card span {
  display: block;
  margin-top: 4px;
  color: #5f6775;
  font-size: 9px;
}

.test-card b {
  color: #606978;
}

.result-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  padding: 10px 13px;
  border: 1px solid #202630;
  border-radius: 7px;
  color: #788190;
  font-family: "JetBrains Mono", monospace;
  font-size: 9px;
}

.result-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #7f8cff;
}

footer {
  display: flex;
  justify-content: space-between;
  padding: 0 0 35px;
  color: #424956;
  font-family: "JetBrains Mono", monospace;
  font-size: 8px;
  letter-spacing: 0.5px;
}

@media (max-width: 850px) {
  .topbar {
    padding: 0 20px;
  }

  .container {
    width: min(100% - 30px, 700px);
  }

  .hero {
    padding: 70px 0;
    align-items: flex-start;
    flex-direction: column;
  }

  .hero-status {
    width: 100%;
  }

  .metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .metric-card:nth-child(2) {
    border-right: 0;
  }

  .product-grid,
  .two-column,
  .test-grid {
    grid-template-columns: 1fr;
  }

  .observability-header {
    flex-direction: column;
  }

  .observability-stack {
    justify-content: flex-start;
  }
}

@media (max-width: 500px) {
  .system-status {
    display: none;
  }

  .hero h1 {
    font-size: 48px;
    letter-spacing: -3px;
  }

  .section {
    padding: 50px 0;
  }

  .observability {
    padding: 22px;
  }

  .table-head,
  .table-row {
    grid-template-columns: 45px 1fr;
  }

  .table-head span:last-child,
  .table-row span:last-child {
    display: none;
  }

  footer {
    flex-direction: column;
    gap: 8px;
  }
}
